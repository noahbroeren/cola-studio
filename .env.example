# ---------------------------------------------------------------------------
# Cola Studio — voorbeeldconfiguratie
#
# VERCEL + UPSTASH (aanbevolen): zet deze waarden in Vercel → Settings →
# Environment Variables. Zie docs/VERCEL.md voor de volledige stappen.
#   Verplicht:   ADMIN_PASSWORD, CRON_SECRET
#   Aanbevolen:  SESSION_SECRET, SITE_URL, ANTHROPIC_API_KEY
#   Upstash:     KV_REST_API_URL + KV_REST_API_TOKEN worden automatisch gezet
#                als je de database via Vercel → Storage koppelt.
#
# EIGEN SERVER: kopieer naar .env (cp .env.example .env) en vul in. Echte
# omgevingsvariabelen (systemd, Docker …) gaan altijd vóór dit bestand.
# Zie docs/BACKEND.md voor uitleg.
# ---------------------------------------------------------------------------

# --- Vercel + Upstash -----------------------------------------------------------
# Upstash REST-gegevens (één van beide paren; via Vercel Storage gaat dit vanzelf)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Geheim dat Vercel Cron meestuurt naar /api/cron/* (willekeurig, 32+ tekens)
CRON_SECRET=

# --- Server -----------------------------------------------------------------
# production = admin alleen met ADMIN_PASSWORD, HSTS achter HTTPS.
# Lokaal testen zonder wachtwoord? Zet NODE_ENV=development.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SITE_URL=https://colastudio.com

# Verplicht in productie. Zonder wachtwoord is het admin-paneel uitgeschakeld
# (in development valt hij terug op "colastudio", met een waarschuwing).
ADMIN_PASSWORD=

# Ondertekent admin-sessies. Leeg = automatisch gegenereerd en bewaard in data/session-secret.
SESSION_SECRET=
# Hoe lang een admin-login geldig blijft (dagen)
SESSION_TTL_DAYS=7

# Mappen (relatief aan de projectmap of absoluut)
DATA_DIR=./data
PUBLIC_DIR=./public
# Admin-uploads (geserveerd op /uploads/*). Leeg = public/uploads.
# Handig op hosts met één persistente schijf, bv. UPLOADS_DIR=/var/data/uploads
UPLOADS_DIR=

# Achter nginx/Caddy: "auto" vertrouwt X-Forwarded-For alleen van een lokale proxy.
# "true" = altijd vertrouwen, "false" = nooit (server direct aan internet).
TRUST_PROXY=auto
# Extra toegestane Origins voor POST/PUT (komma-gescheiden), bv. https://www.colastudio.com
ALLOWED_ORIGINS=

# Content-Security-Policy voor HTML-pagina's. Leeg = ingebouwde policy,
# "off" = uit, of je eigen policy-tekst.
CSP=
# Cache voor /assets zonder ?v= (seconden; 604800 = 7 dagen)
ASSET_MAX_AGE=604800
# 1 = elk request loggen
LOG_REQUESTS=0
# 1 = achtergrondtaken (Weibo, Weidian, wisselkoersen) uitzetten
DISABLE_SCHEDULERS=0

# --- Weibo (kan ook in Admin → Integrations; env wint) ----------------------
# Standaard staat Weibo AAN met het Cola Studio-account 7354109778
# (https://weibo.com/u/7354109778). Alleen invullen om dat te wijzigen.
WEIBO_ENABLED=
WEIBO_UID=
# Cookie-string uit je browser als Weibo de server blokkeert (zie docs/BACKEND.md)
WEIBO_COOKIE=
WEIBO_INTERVAL_MINUTES=
WEIBO_AUTO_PUBLISH=
# Aantal posts dat bij de allereerste run wordt geïmporteerd (standaard 6)
WEIBO_BACKFILL=
# Maximale videogrootte die lokaal wordt bewaard (MB)
WEIBO_VIDEO_MAX_MB=60

# --- Vertaling ----------------------------------------------------------------
# anthropic | deepl | google | libre | none
TRANSLATION_PROVIDER=
ANTHROPIC_API_KEY=
# Leeg = instelling uit het admin-paneel (standaard claude-sonnet-5-5)
ANTHROPIC_MODEL=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- Weidian ------------------------------------------------------------------
WEIDIAN_ENABLED=
# public-item | open-api | json-feed | mock
WEIDIAN_PROVIDER=
WEIDIAN_INTERVAL_MINUTES=
WEIDIAN_APP_KEY=
WEIDIAN_APP_SECRET=
WEIDIAN_ACCESS_TOKEN=
WEIDIAN_FEED_URL=
# Optional: only if Weidian blocks the server. Scraping service URL with your key, {url} = the Weidian request.
# WEIDIAN_FETCH_VIA=https://api.scraperapi.com/?api_key=YOUR_KEY&url={url}
